# Memeforge server configuration (copy to .env and adjust)

# --- LLM connectors --------------------------------------------------------
# Default provider: mock | openai | ollama
MEMEFORGE_LLM_PROVIDER=mock

# OpenAI-compatible endpoint (OpenAI, OpenRouter, LM Studio, vLLM, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- TTS --------------------------------------------------------------------
# Default provider: edge (free) | meme_classic (free — Brian & the classic
# meme voices) | tiktok (free, legacy with auto-fallback) | google (free
# reliability fallback) | azure | elevenlabs
MEMEFORGE_TTS_PROVIDER=edge
MEMEFORGE_EDGE_VOICE=en-US-ChristopherNeural

# Meme Classic voices (free, keyless ttsmp3 API; see app/providers/tts/meme_classic.py)
# Brian=iconic British meme voice, Justin=kid/teen, Matthew=deep narrator,
# Kendra, Salli, Joey, Ivy, Joanna
MEMEFORGE_MEME_CLASSIC_VOICE=Brian

# Google Translate TTS (free, keyless; see app/providers/tts/google.py)
# Voice id maps to the `tl` language code: en, en-GB, en-AU, en-IN
MEMEFORGE_GOOGLE_TTS_VOICE=en

# TikTok meme voices (free, keyless; see app/providers/tts/tiktok.py)
# Jessie=en_us_002, Serious Male=en_male_cody, Narrator=en_male_narration,
# Ghostface=en_us_ghostface, Trickster=en_us_trickster
# NOTE: the unofficial WXA mirrors often reject anonymous calls (403/404).
# Synthesis automatically falls back to edge-tts, then Brian — or set a
# session cookie / self-hosted proxy below to force real TikTok voices.
MEMEFORGE_TIKTOK_VOICE=en_us_002
# Optional: comma-separated override of the WXA endpoint mirrors to try
# MEMEFORGE_TIKTOK_TTS_URLS=https://api16-normal-v6.tiktokv.com/16/api/v1/wxa/tts
# Optional: TikTok `sessionid` cookie from a logged-in tiktok.com browser
# session — restores WXA access on mirrors that reject anonymous calls.
# TIKTOK_SESSION_ID=
# (also readable as MEMEFORGE_TIKTOK_SESSION_ID)

# Azure Speech (paid tier; same neural voices as edge-tts)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs (premium voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Rendering ----------------------------------------------------------------
# ffmpeg binary (defaults to `ffmpeg` on PATH)
MEMEFORGE_FFMPEG=ffmpeg
MEMEFORGE_VIDEO_WIDTH=1080
MEMEFORGE_VIDEO_HEIGHT=1920
MEMEFORGE_VIDEO_FPS=30
# MEMEFORGE_OUTPUT_DIR=/var/lib/memeforge/outputs

# --- Stock video (backgrounds) -------------------------------------------------
# Free-tier API keys for the studio "Stock Video Search" background step:
#   Pexels:   https://www.pexels.com/api/
#   Pixabay:  https://pixabay.com/api/docs/
# Without keys the search falls back to a small set of curated demo clips.
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Optional tuning (defaults shown)
# MEMEFORGE_STOCK_SEARCH_TIMEOUT_S=15.0
# MEMEFORGE_STOCK_DOWNLOAD_TIMEOUT_S=120.0
# MEMEFORGE_STOCK_MAX_CLIP_BYTES=262144000
# MEMEFORGE_STOCK_MAX_CLIPS=12
